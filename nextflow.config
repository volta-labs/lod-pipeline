manifest {
    name            = 'volta-labs/lod-pipeline'
    description     = 'SeraCare LOD variant calling — LoFreq + VarDict'
    nextflowVersion = '>=25.10.0'
}

// ── Default parameters ────────────────────────────────────────────────────────
params {
    bam_dir     = null
    ref         = null
    bed         = null   // S3 path to SG_MSKACCESSFLEX_v1_target_hg38.bed
    gc_cache    = null   // S3 path to SG_MSKACCESSFLEX_v1_target_hg38_gc.csv
    samplesheet = null   // S3 path to samplesheet CSV (sample,condition,pool)
    truth_set   = null   // S3 path to truth set CSV; defaults to bundled file
    outdir      = null
    min_vaf     = 0.001
    min_cov     = 5
}

// ── Wave (auto-builds containers from conda specs) ────────────────────────────
wave {
    enabled  = true
    strategy = ['conda', 'container']
}

// ── Docker (required for Wave) ────────────────────────────────────────────────
docker {
    enabled = true
}

// ── Fusion FS (transparent S3 access) ────────────────────────────────────────
fusion {
    enabled = true
}

// ── AWS ───────────────────────────────────────────────────────────────────────
aws {
    region = 'us-east-1'
    batch {
        cliPath = '/usr/local/bin/aws'
    }
    client {
        uploadChunkSize = '10 MB'
        maxErrorRetry   = 10
    }
}

// ── Work directory ────────────────────────────────────────────────────────────
workDir = 's3://vl-nextflow/scratch/'

// ── Seqera Platform ───────────────────────────────────────────────────────────
tower {
    enabled     = true
    endpoint    = 'https://api.cloud.seqera.io'
    workspaceId = 'Volta_Labs/app_dev'
}

// ── Process defaults ──────────────────────────────────────────────────────────
process {
    executor = 'awsbatch'

    withName: 'LOFREQ' {
        cpus   = 8
        memory = '32 GB'
        time   = '4 h'
    }

    withName: 'VARDICT' {
        cpus   = 8
        memory = '32 GB'
        time   = '2 h'
    }

    withName: 'LOD_CURVE' {
        cpus   = 2
        memory = '8 GB'
        time   = '30 min'
    }
}

// ── Local profile (for testing without AWS) ───────────────────────────────────
profiles {
    local {
        process.executor = 'local'
        wave.enabled     = false
        fusion.enabled   = false
        docker.enabled   = false
        workDir          = 'work'
    }
}
